# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local dev-only data stores (Postgres/S3 stand-ins — see prisma/schema.prisma)
/prisma/dev.db
/prisma/dev.db-journal
/dev.db
/dev.db-journal
/uploads

# typescript
*.tsbuildinfo
next-env.d.ts

# a separate, independent Next.js reference project (own node_modules/.next) —
# not part of this app, dropped in as a design reference. See CLAUDE.md.
/mias

# Claude Code tooling/skills — not application code
/.claude

# generated docs artifacts — docs/HOW_IT_WORKS.md is the tracked source;
# PDF exports of it are local-only, regenerate on demand
docs/*.pdf
