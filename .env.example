# Postgres connection string (Neon via Vercel Marketplace recommended). Use
# the pooled connection string here — required for every deploy now that
# prisma/schema.prisma targets "postgresql".
DATABASE_URL=
# Unpooled connection string, kept for occasional manual use. NOT used by
# `prisma migrate` here (see package.json's vercel-build script) — this
# project's Neon Auth integration holds a long-lived session on the
# unpooled endpoint whose advisory lock ID collides with Prisma migrations',
# so migrate commands go through the pooled DATABASE_URL instead, which has
# worked reliably in practice. Not read by the app itself at runtime.
# Matches the name Vercel's Neon Marketplace integration auto-provisions.
DATABASE_URL_UNPOOLED=

# Resend (https://resend.com) — required for real contact/submission emails.
# Without RESEND_API_KEY, both API routes fall back to logging instead of
# sending (see src/lib/email.ts), so the app still runs without it locally.
RESEND_API_KEY=
# Must be on a domain verified with Resend (institute.mikaelsoninitiative.org
# verified 2026-08-13 — e.g. noreply@institute.mikaelsoninitiative.org).
# Defaults to Resend's shared onboarding@resend.dev sender if unset, which
# only works in Resend's sandbox mode, not for real production sends.
RESEND_FROM_EMAIL=
# Inbox that receives contact-form/submission notifications. Confirmed
# 2026-08-13: institute@mikaelsoninitiative.org (also the code default in
# src/lib/email.ts if this is left unset).
CONTACT_NOTIFICATION_EMAIL=

# Vercel Blob (Storage tab on the Vercel dashboard) — required in production
# for paper-submission file uploads. Without it, uploads fall back to the
# local filesystem, which only works under `npm run dev` (see
# src/app/api/submissions/route.ts).
BLOB_READ_WRITE_TOKEN=

# The site's real production domain (once confirmed — see
# docs/backend-services-plan.md open questions). Used to build absolute URLs
# in sitemap.xml/robots.txt. Falls back to the Vercel deployment URL if unset.
NEXT_PUBLIC_SITE_URL=

# Auth.js (next-auth v5) — backs the /signup Google + email-code sign-in
# flow (src/auth.ts). Generate AUTH_SECRET with `npx auth secret` or
# `openssl rand -base64 32`. AUTH_GOOGLE_ID/SECRET come from a Google Cloud
# OAuth client — its Authorized redirect URIs must include
# http://localhost:3000/api/auth/callback/google and
# https://institute.mikaelsoninitiative.org/api/auth/callback/google.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Feature flag for the hero's ambient palimpsest-name drift. Set to "false"
# to disable.
NEXT_PUBLIC_ENABLE_HERO_DRIFT=true

# Paystack (https://paystack.com) — powers /library/support checkout (see
# src/lib/paystack.ts). PAYSTACK_SECRET_KEY initializes/verifies transactions
# server-side and validates webhook signatures; use a test key (sk_test_...)
# until the flow is confirmed, then swap to a live key (sk_live_...).
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY isn't used by the current hosted-checkout
# redirect flow, but is here for a future inline Paystack widget.
# Webhook URL to configure in the Paystack dashboard:
# https://<your-domain>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Google Analytics 4 measurement ID (src/app/layout.tsx). Not a secret — GA4
# IDs are meant to be public, they're visible in every page's source anyway.
# Only fires when VERCEL_ENV === "production", so local dev and preview
# deployments never report to the live property. Find it in the GA4 admin
# under Data Streams (format: G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Upstash Redis — backs rate limiting in src/lib/rate-limit.ts (OTP
# verification/sending, and public form submissions). Without either pair
# below set, rate limiting fails open (routes work unthrottled) — set one
# pair in production. If provisioned via the Vercel Marketplace's KV
# integration, it auto-populates KV_REST_API_URL/KV_REST_API_TOKEN instead
# (same REST API, different names) — src/lib/rate-limit.ts accepts either.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
