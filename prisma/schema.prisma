// MIAS_PRD.md Sec. 3/7: production datasource is Postgres (Neon via Vercel
// Marketplace, or another Marketplace Postgres provider). Set DATABASE_URL to
// a real Postgres connection string — see .env.example.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum SubmissionStatus {
  submitted
  in_review
  revisions_requested
  accepted
  rejected
  published
}

// MIAS_PRD.md Sec. 6/7 — Phase 1 scope only. Reviewer notes, volume
// assignment, and registered-author accounts arrive with Phase 2/3's editor
// dashboard and are intentionally not modeled yet.
model Submission {
  id          String            @id @default(cuid())
  title       String
  abstract    String
  focusArea   String
  authorName  String
  authorEmail String
  fileUrl     String
  fileName    String
  status      SubmissionStatus  @default(submitted)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Phase 2 lightweight CMS — moves genuinely growing site content (team
// roster, partner list, recommended reading) out of hardcoded arrays so
// non-technical staff can edit it without a code deploy. Editable for now
// via Prisma Studio (`npx prisma studio`) rather than a dedicated admin UI —
// see docs/backend-services-plan.md, which defers a real admin dashboard to
// Phase 3 pending an auth decision.
model TeamMember {
  id           String   @id @default(cuid())
  category     String
  sortOrder    Int      @default(0)
  displayIndex String
  name         String
  role         String
  affiliation  String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, sortOrder])
}

model Partner {
  id        String   @id @default(cuid())
  sortOrder Int      @default(0)
  name      String
  type      String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model BookRecommendation {
  id        String   @id @default(cuid())
  category  String   @default("Book") // E.g., "Book" or "Archive"
  genre     String
  sortOrder Int      @default(0)
  title     String
  imgUrl    String
  linkUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, genre, sortOrder])
}

// Auth.js (next-auth v5) schema, standard shape per @auth/prisma-adapter —
// see src/auth.ts. Backs the /signup Google sign-in flow. This is the
// registered-account model the Submission schema comment above deferred to
// "Phase 2/3's editor dashboard" — not yet wired to Submission itself.
model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]
  cohortApplication CohortApplication?
  stepProgress      StepProgress[]
}

enum CohortApplicationStatus {
  pending
  admitted
  rejected
  waitlisted
}

// A Cohort 01 application, not just a profile — see /signup's post-signin
// questions. One per user, reviewed via /admin. Confirmation email to the
// applicant + notification to staff both fire on creation (src/lib/email.ts).
//
// firstTimeStudying/primaryGoal are the original fixed-choice questions;
// about/motivation were added alongside them (not a replacement) so
// reviewers get both a quick filter and real, open-ended context.
model CohortApplication {
  id                String   @id @default(cuid())
  userId            String   @unique
  firstTimeStudying String
  primaryGoal       String
  about             String
  motivation        String
  // Added 2026-08-14 alongside the new "details" signup step. Nullable —
  // applications submitted before this field existed have no real value to
  // backfill, so it's required at the Zod/form level for new submissions
  // only, not enforced at the DB level.
  phoneNumber       String?
  gender            String?
  nationality       String?
  stateOfOrigin     String?
  additionalInfo    String?
  reviewed          Boolean  @default(false)
  createdAt         DateTime @default(now())

  // Added for the /learn LMS — distinct from `reviewed` ("staff looked at
  // it"), this is the actual admission decision that gates LMS login.
  status   CohortApplicationStatus @default(pending)
  cohortId String?
  cohort   Cohort?                 @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([cohortId])
}

// Backs /learn — a cohort's LMS content and enrollment. One Cohort has many
// Modules (its curriculum) and many CohortApplications (its admitted, and
// not-yet-decided, applicants).
model Cohort {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications CohortApplication[]
  modules      Module[]
  events       CohortEvent[]
}

// Backs the Space page's "Cohort Activity & Milestones" panel — live
// masterclasses, office hours, and assignment deadlines. type is a plain
// validated string ("masterclass" | "office_hours" | "deadline"), matching
// this schema's informal-enum convention (see ModuleStep.type). Editable via
// Prisma Studio, same as everything else in this app — no authoring UI yet.
model CohortEvent {
  id          String   @id @default(cuid())
  cohortId    String
  type        String
  title       String
  description String?
  startsAt    DateTime
  meetingUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId, startsAt])
}

// A single lesson within a Cohort's curriculum. unlockDate gates visibility
// on the student dashboard/viewer; orderIndex controls display order.
// Content itself lives one level down, in ModuleStep — a Module is a
// container of steps, not content directly.
model Module {
  id          String   @id @default(cuid())
  cohortId    String
  title       String
  description String?
  unlockDate  DateTime
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cohort Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  steps  ModuleStep[]

  @@index([cohortId, orderIndex])
}

// One unit of content within a Module — a Module is now a container of
// steps, not content directly. type is a plain validated string, not a
// Prisma enum, matching this schema's existing informal-enum convention
// (see TeamApplication.roleInterest, Module.videoProvider): "video" |
// "text" | "file" | "quiz" today, easy to add more later without an
// enum-altering migration.
model ModuleStep {
  id         String @id @default(cuid())
  moduleId   String
  type       String
  title      String
  orderIndex Int    @default(0)

  // type: "video"
  videoUrl      String?
  videoProvider String?
  videoId       String?
  audioUrl      String?

  // type: "text"
  contentMarkdown String?

  // type: "file"
  fileUrl  String?
  fileName String?

  // type: "quiz" — { passingScore: number, questions: [{ id, prompt,
  // options: [{ id, text, isCorrect }] }] }. JSON rather than relational
  // Quiz/Question/Option tables: no cross-quiz querying is needed, this is
  // small-scale Prisma-Studio-entered data, and a single JSON blob is
  // easier to hand-edit there than three joined tables would be.
  quizData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module   Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress StepProgress[]

  @@index([moduleId, orderIndex])
}

// One row per (user, step) once a student completes that step. For quiz
// steps, score/answers capture the graded result — always recomputed
// server-side at submission time from the step's own quizData, never
// trusted from the client.
model StepProgress {
  id          String    @id @default(cuid())
  userId      String
  stepId      String
  completed   Boolean   @default(false)
  completedAt DateTime?
  score       Int?
  answers     Json?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  step ModuleStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId])
  @@index([stepId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  // Not part of Auth.js's standard shape — added so send-code can enforce a
  // per-email cooldown (see src/lib/otp.ts) without a separate rate-limit
  // store, given the Resend free-tier daily cap this is guarding.
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

model GalleryItem {
  id          String   @id @default(cuid())
  sortOrder   Int      @default(0)
  title       String
  description String?
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

enum ContributionStatus {
  pending
  completed
  failed
}

// Backs /library/support (the "1,000,000 Books Project"). A row is created
// the moment someone submits the pledge form, status "pending" — actually
// charging the card is the payment integration, out of scope here. Staff can
// flip status to "completed" from the admin dashboard once a payment is
// confirmed (manually for now, or via a future Paystack webhook), which is
// what makes a pledge count toward the progress tracker and leaderboard.
model LibraryContribution {
  id        String             @id @default(cuid())
  name      String
  email     String
  amount    Int
  tier      String?
  status    ContributionStatus @default(pending)
  reference String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Backs /join-team. A general volunteer/team application, replacing the
// external Google Form the "Join Our Team" buttons (About, Team pages)
// used to point to.
model TeamApplication {
  id                String   @id @default(cuid())
  name              String
  email             String
  phoneNumber       String
  location          String
  roleInterest      String
  customRole        String?
  availability      String
  hoursPerWeek      Int
  volunteeredBefore Boolean
  experience        String
  linkedinUrl       String
  cvUrl             String
  cvFileName        String
  motivation        String
  reviewed          Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([reviewed])
  @@index([createdAt])
}
