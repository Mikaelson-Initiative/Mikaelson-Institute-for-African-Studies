// MIAS_PRD.md Sec. 3/7: production datasource is Postgres (Neon via Vercel
// Marketplace, or another Marketplace Postgres provider). Set DATABASE_URL to
// a real Postgres connection string — see .env.example.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum SubmissionStatus {
  submitted
  in_review
  revisions_requested
  accepted
  rejected
  published
}

// MIAS_PRD.md Sec. 6/7 — Phase 1 scope only. Reviewer notes, volume
// assignment, and registered-author accounts arrive with Phase 2/3's editor
// dashboard and are intentionally not modeled yet.
model Submission {
  id          String            @id @default(cuid())
  title       String
  abstract    String
  focusArea   String
  authorName  String
  authorEmail String
  fileUrl     String
  fileName    String
  status      SubmissionStatus  @default(submitted)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

// Phase 2 lightweight CMS — moves genuinely growing site content (team
// roster, partner list, recommended reading) out of hardcoded arrays so
// non-technical staff can edit it without a code deploy. Editable for now
// via Prisma Studio (`npx prisma studio`) rather than a dedicated admin UI —
// see docs/backend-services-plan.md, which defers a real admin dashboard to
// Phase 3 pending an auth decision.
model TeamMember {
  id           String   @id @default(cuid())
  category     String
  sortOrder    Int      @default(0)
  displayIndex String
  name         String
  role         String
  affiliation  String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, sortOrder])
}

model Partner {
  id        String   @id @default(cuid())
  sortOrder Int      @default(0)
  name      String
  type      String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model BookRecommendation {
  id        String   @id @default(cuid())
  genre     String
  sortOrder Int      @default(0)
  title     String
  imgUrl    String
  linkUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([genre, sortOrder])
}
